# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). Never commit .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — only needed once you have a real Click/Payme merchant account.
# Leaving these blank keeps the booking flow on the simulated "held by
# Whale" confirmation. Setting them switches Click/Payme to real checkout
# redirects (see src/lib/payments.ts and supabase/functions/*-webhook).
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_SERVICE_ID=
VITE_PAYME_MERCHANT_ID=
